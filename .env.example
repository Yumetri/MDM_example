# Local-only development credentials. Replace them outside local development.
MDM_DATABASE_URL=postgresql+asyncpg://mdm:mdm-local@127.0.0.1:55432/mdm
MDM_TEST_DATABASE_URL=postgresql+asyncpg://mdm:mdm-local@127.0.0.1:55432/mdm_test
MDM_AUTH_PASSWORD_HASH_MEMORY_MIB=19
MDM_AUTH_PASSWORD_HASH_ITERATIONS=2
MDM_AUTH_PASSWORD_HASH_PARALLELISM=1
MDM_AUTH_PASSWORD_HASH_MAX_CONCURRENCY=2
MDM_AUTH_PASSWORD_HASH_ACQUIRE_TIMEOUT_SECONDS=2.0
MDM_AUTH_JWT_ACTIVE_KID=local-dev
MDM_AUTH_JWT_PRIVATE_KEY_PATH=secrets/local/jwt-private.pem
MDM_AUTH_JWT_JWKS_PATH=secrets/local/jwt-public-keys.json
# #38·#39 email delivery configuration (required when those flows are enabled).
# MDM_EMAIL_PUBLIC_APP_BASE_URL=https://app.example.net
# MDM_EMAIL_SMTP_HOST=smtp.example.net
# MDM_EMAIL_SMTP_PORT=587
# MDM_EMAIL_SMTP_SECURITY=STARTTLS
# MDM_EMAIL_SMTP_USERNAME=replace-me
# MDM_EMAIL_SMTP_PASSWORD=replace-me
# MDM_EMAIL_SENDER_ADDRESS=noreply@example.net
# MDM_EMAIL_SMTP_TIMEOUT_SECONDS=10.0
