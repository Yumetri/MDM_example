# Local-only development credentials. Replace them outside local development.
MDM_DATABASE_URL=postgresql+asyncpg://mdm:mdm-local@127.0.0.1:55432/mdm
MDM_TEST_DATABASE_URL=postgresql+asyncpg://mdm:mdm-local@127.0.0.1:55432/mdm_test
MDM_AUTH_PASSWORD_HASH_MEMORY_MIB=19
MDM_AUTH_PASSWORD_HASH_ITERATIONS=2
MDM_AUTH_PASSWORD_HASH_PARALLELISM=1
MDM_AUTH_PASSWORD_HASH_MAX_CONCURRENCY=2
MDM_AUTH_PASSWORD_HASH_ACQUIRE_TIMEOUT_SECONDS=2.0
MDM_AUTH_JWT_ACTIVE_KID=local-dev
MDM_AUTH_JWT_PRIVATE_KEY_PATH=secrets/local/jwt-private.pem
MDM_AUTH_JWT_JWKS_PATH=secrets/local/jwt-public-keys.json
# Set true only after configuring JWT keys, allowed origins and the IP HMAC secret.
MDM_AUTH_SESSIONS_ENABLED=false
# Enable only with sessions and complete email delivery configuration below.
MDM_AUTH_REGISTRATIONS_ENABLED=false
# Exact email domains only; subdomains must be listed separately. Empty denies registration.
MDM_AUTH_REGISTRATION_ALLOWED_DOMAINS=[]
# #44 browser protection (required when #37/#38/#39 authentication routers are assembled).
# Supply an independently generated 32-byte secret as 43-character unpadded base64url.
# MDM_AUTH_IP_HMAC_SECRET=<inject-from-secret-store>
MDM_AUTH_ALLOWED_ORIGINS=[]
MDM_AUTH_ALLOW_INSECURE_LOCAL_COOKIES=false
MDM_AUTH_RATE_LIMIT_CAPACITY=100000
# Pending operational log events, excluding the one currently being written.
# When full, new events are dropped without delaying authentication requests.
MDM_AUTH_LOG_QUEUE_CAPACITY=1024
# Local HTTP only: set both values explicitly (other HTTP hosts are rejected).
# MDM_AUTH_ALLOWED_ORIGINS=["http://localhost:8000"]
# MDM_AUTH_ALLOW_INSECURE_LOCAL_COOKIES=true
# #38·#39 email delivery configuration (required when those flows are enabled).
# MDM_EMAIL_PUBLIC_APP_BASE_URL=https://app.example.net
# MDM_EMAIL_SMTP_HOST=smtp.example.net
# MDM_EMAIL_SMTP_PORT=587
# MDM_EMAIL_SMTP_SECURITY=STARTTLS
# MDM_EMAIL_SMTP_USERNAME=replace-me
# MDM_EMAIL_SMTP_PASSWORD=replace-me
# MDM_EMAIL_SENDER_ADDRESS=noreply@example.net
# MDM_EMAIL_SMTP_TIMEOUT_SECONDS=10.0
